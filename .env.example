# Copy this file to ".env" and adjust. ".env" is git-ignored and must never be committed.
# Used by both Spring Boot (when run from this folder) and docker compose.

# --- Database ---
DB_NAME=aives_db
DB_USER=admin
DB_PASSWORD=change-me
DB_PORT=5432
# DB_URL=jdbc:postgresql://localhost:5432/aives_db

# --- JWT ---
# Generate your own with:  openssl rand -base64 32
JWT_SECRET=
# JWT_EXPIRATION_MS=86400000

# --- Object storage (MinIO container; the app uses local files until M3) ---
MINIO_ROOT_USER=aives
MINIO_ROOT_PASSWORD=change-me-too

# --- App ---
# Profile for the backend container (docker compose --profile app). demo = demo accounts/data, password Aives@123.
SPRING_PROFILES_ACTIVE=demo
# mock = no AI keys needed
AI_MODE=mock

# --- CORS (comma-separated frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
